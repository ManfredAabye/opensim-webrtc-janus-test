[ServiceList]
	VoiceServiceConnector = "${Const|PrivatePort}/WebRtcVoice.dll:WebRtcVoiceServerConnector"

[WebRtcVoice]
    Enabled = true
    SpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService
    NonSpatialVoiceService = WebRtcJanusService.dll:WebRtcJanusService

[JanusWebRtcVoice]
	JanusGatewayURI = http://127.0.0.1:8088/janus
    JanusDebug = false
    APIToken = mypasswd
    JanusGatewayAdminURI = http://127.0.0.1:7088/admin
    AdminAPIToken = mypasswd
    ; Plugin package to attach in Janus. Upstream default:
    ; JanusAudioBridgePlugin = janus.plugin.audiobridge
    ; OpenSim custom plugin (if compatible):
    JanusAudioBridgePlugin = janus.plugin.opensim.audiobridge